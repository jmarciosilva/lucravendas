[mysqld]
# Charset padrão UTF-8 multibyte (suporte a emojis e caracteres especiais)
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Modo estrito para evitar inserções silenciosas de dados inválidos
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO

# Tamanho máximo do pacote para imports e blobs de imagens
max_allowed_packet = 64M

[client]
default-character-set = utf8mb4
