APP_NAME=LucraVendas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Banco de Dados ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lucravendas
DB_USERNAME=lucravendas
DB_PASSWORD=secret

# ─── Sessão e Cache ───────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── E-mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lucravendas.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS / S3 ─────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=lucravendas
AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO local (substitui S3 em desenvolvimento)
# AWS_ENDPOINT=http://minio:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true

FILAMENT_FILESYSTEM_DISK=s3

# ─── Meilisearch ──────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

# ─── Multi-tenancy ────────────────────────────────────────────────────────────
# Domínio raiz para wildcard de subdomínios dos tenants
TENANCY_ROOT_DOMAIN=lucravendas.com.br

# ─── Mercado Pago (PIX, cartão de crédito, boleto) ───────────────────────────
# Obter credenciais em: https://www.mercadopago.com.br/developers/panel
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SANDBOX=true

# ─── Meta Graph API (Instagram + Facebook) ───────────────────────────────────
# Criar app em: https://developers.facebook.com/apps
# Scopes: pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/marketing/oauth/callback
META_API_VERSION=v19.0
META_SANDBOX=true

# Quando true, agenda um post automático ao publicar um produto
MARKETING_AUTO_POST=false

# ─── Backup automático (spatie/laravel-backup) ───────────────────────────────
# Disco onde os backups são armazenados: 's3' (produção) ou 'local' (dev)
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=        # opcional: criptografia do arquivo ZIP

# ─── Sentry — rastreamento de erros em produção ──────────────────────────────
# Obter DSN em: https://sentry.io → Settings → Projects → Client Keys
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="${APP_ENV}"

# ─── Laravel Telescope — diagnóstico (apenas local e staging) ────────────────
TELESCOPE_ENABLED=true
# E-mails com acesso ao Telescope em staging (separados por vírgula)
TELESCOPE_ALLOWED_EMAILS="jmarciosilva@gmail.com"

# ─── Laravel Horizon — dashboard de filas (requer Linux/Docker) ──────────────
# Acesse em /horizon (restrito a super_admin)
HORIZON_ENABLED=true

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"
